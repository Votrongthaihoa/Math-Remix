{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "remix-public-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "media.mathremix.pro.vn",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "remix-private-lessons"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
