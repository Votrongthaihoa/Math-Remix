{
  "name": "remix-education",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "core-js": false,
    "esbuild@0.18.20 || 0.25.12 || 0.27.3 || 0.28.0 || 0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260515.1 || 1.20260825.1": true
  },
  "scripts": {
    "dev": "cross-env VINEXT_CLOUDFLARE_DEV=0 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:platform": "npm run dev --workspace @aeck/platform",
    "dev:platform:admin": "npm run dev:admin --workspace @aeck/platform",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:platform": "npm run build --workspace @aeck/platform",
    "build:platform:production": "npm run build:production --workspace @aeck/platform",
    "build:vercel": "next build",
    "start": "node scripts/start-worker.mjs",
    "start:node": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "email:test": "node --env-file=.env.local scripts/test-resend.mjs",
    "encode:hls:native": "node scripts/encode-hls-native.mjs",
    "ffmpeg:agent": "node scripts/native-hls-agent.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:platform": "npm run typecheck --workspace @aeck/platform && npm run typecheck --workspace @aeck/contracts",
    "test:platform": "npm run test --workspace @aeck/contracts && npm run test --workspace @aeck/platform",
    "test": "npm run typecheck && npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "smoke:dev": "node scripts/dev-port-smoke.mjs",
    "smoke:worker": "node scripts/worker-runtime-smoke.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "release:check": "npm run lint && npm test && npm audit --omit=dev --audit-level=high && npm run smoke:worker && npm run test:e2e",
    "deploy:check": "node scripts/deploy-readiness-check.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@supabase/supabase-js": "^2.110.8",
    "drizzle-orm": "0.45.2",
    "hls.js": "1.6.13",
    "katex": "^0.18.1",
    "lucide-react": "^1.26.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
